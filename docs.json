{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Voice Agents",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "python", "node"],
      "defaults": "required",
      "prefill": true
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "general/overview",
              "general/tiers",
              "general/roadmap",
              "general/campaign",
              "general/faq"
            ]
          },
          {
            "group": "Developers",
            "pages": [
              "developers/introduction",
              "developers/customer-lifecycle",
              "developers/create-assistant",
              "developers/make-a-call",
              "developers/call-lifecycle-events",
              "developers/webhook-signature",
              "developers/assistant-sandbox"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/abandon-cart-recovery",
              "guides/how-discounts-work"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/shopify",
              "integrations/whatsapp",
              "integrations/limechat",
              "integrations/klaviyo",
              "integrations/google-calendar"
            ]
          },
          {
            "group": "Use Cases",
            "pages": ["usecases/retail", "usecases/b2b", "usecases/healthcare"]
          }
        ]
      },
      {
        "tab": "API v2",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["v2/overview", "v2/quickstart", "v2/migration"]
          },
          {
            "group": "Resources",
            "pages": [
              "v2/agents",
              "v2/voices",
              "v2/calls",
              "v2/wallet",
              "v2/webhooks"
            ]
          },
          {
            "group": "Reference",
            "pages": ["v2/errors", "v2/limits", "v2/node-graphs", "v2/faq"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/introduction"]
          },
          {
            "group": "API v1 (stable)",
            "pages": [
              "v1/overview",
              "v1/workspaces",
              "v1/assistants",
              "v1/calls",
              "v1/webhooks",
              "v1/telephony",
              "v1/tools",
              "v1/knowledge-base"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "https://api.voice-agents.miraiminds.co/swagger.yaml"
          }
        ]
      }
    ]
  },
  "redirects": [
    { "source": "/v2", "destination": "/v2/overview" },
    { "source": "/v1", "destination": "/v1/overview" }
  ],
  "topbar": {
    "style": "gradient"
  },
  "navbar": {
    "links": [
      {
        "label": "Schedule Demo",
        "href": "https://calendar.google.com/calendar/appointments/schedules/AcZssZ0xP6nxXZ5RWb6zQrYcADLF1-g6p-fyyMm5rdE6z6SHqNQPBPEJzoVdY--CLtVXGHy8H80RTyHV?gv=true"
      },
      {
        "label": "Support",
        "href": "mailto:sneh@miraiminds.co"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {}
  }
}
