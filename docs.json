{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Voice Agents",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "python", "node"],
      "defaults": "required",
      "prefill": true
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "index",
              "v2/start-building",
              "v2/quickstart",
              "v2/overview"
            ]
          },
          {
            "group": "Build",
            "pages": [
              "v2/agents",
              "v2/voices",
              "v2/calls",
              "v2/campaigns",
              "v2/dnc",
              "v2/webhooks"
            ]
          },
          {
            "group": "Money",
            "pages": ["general/tiers", "v2/wallet"]
          },
          {
            "group": "Reference",
            "pages": [
              "v2/errors",
              "v2/limits",
              "v2/faq",
              "general/roadmap"
            ]
          }
        ]
      },
      {
        "tab": "v1 (legacy)",
        "groups": [
          {
            "group": "Start",
            "pages": [
              "general/overview",
              "v2/migration",
              "general/campaign",
              "general/faq"
            ]
          },
          {
            "group": "Developer guides",
            "pages": [
              "developers/introduction",
              "developers/customer-lifecycle",
              "developers/create-assistant",
              "developers/make-a-call",
              "developers/call-lifecycle-events",
              "developers/webhook-signature",
              "developers/assistant-sandbox"
            ]
          },
          {
            "group": "API v1 reference",
            "pages": [
              "v1/overview",
              "v1/workspaces",
              "v1/assistants",
              "v1/calls",
              "v1/webhooks",
              "v1/telephony",
              "v1/tools",
              "v1/knowledge-base",
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "https://api.voice-agents.miraiminds.co/swagger.yaml"
          },
          {
            "group": "Guides",
            "pages": [
              "guides/abandon-cart-recovery",
              "guides/how-discounts-work"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/shopify",
              "integrations/whatsapp",
              "integrations/limechat",
              "integrations/klaviyo",
              "integrations/google-calendar"
            ]
          },
          {
            "group": "Use cases",
            "pages": ["usecases/retail", "usecases/b2b", "usecases/healthcare"]
          }
        ]
      }
    ]
  },
  "redirects": [
    { "source": "/v2", "destination": "/v2/overview" },
    { "source": "/v1", "destination": "/v1/overview" },
    { "source": "/v2/node-graphs", "destination": "/general/roadmap" }
  ],
  "topbar": {
    "style": "gradient"
  },
  "navbar": {
    "links": [
      {
        "label": "Schedule Demo",
        "href": "https://calendar.google.com/calendar/appointments/schedules/AcZssZ0xP6nxXZ5RWb6zQrYcADLF1-g6p-fyyMm5rdE6z6SHqNQPBPEJzoVdY--CLtVXGHy8H80RTyHV?gv=true"
      },
      {
        "label": "Support",
        "href": "mailto:sneh@miraiminds.co"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {}
  }
}
