{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Voice Agents",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "python", "node"],
      "defaults": "required",
      "prefill": true
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Start here",
            "pages": ["index", "v2/quickstart", "v2/overview"]
          },
          {
            "group": "Build",
            "pages": [
              "v2/agents",
              "v2/voices",
              "v2/calls",
              "v2/webhooks"
            ]
          },
          {
            "group": "Money",
            "pages": ["general/tiers", "v2/wallet"]
          },
          {
            "group": "Reference",
            "pages": [
              "v2/errors",
              "v2/limits",
              "v2/faq",
              "general/roadmap"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    { "source": "/v2", "destination": "/v2/overview" },
    { "source": "/v1", "destination": "/v2/overview" },
    { "source": "/v1/:slug*", "destination": "/v2/overview" },
    { "source": "/v2/migration", "destination": "/v2/overview" },
    { "source": "/v2/node-graphs", "destination": "/general/roadmap" },
    { "source": "/developers/:slug*", "destination": "/v2/quickstart" },
    { "source": "/api-reference/:slug*", "destination": "/v2/overview" },
    { "source": "/guides/:slug*", "destination": "/" },
    { "source": "/integrations/:slug*", "destination": "/" },
    { "source": "/usecases/:slug*", "destination": "/" },
    { "source": "/general/overview", "destination": "/" },
    { "source": "/general/campaign", "destination": "/" },
    { "source": "/general/faq", "destination": "/v2/faq" }
  ],
  "topbar": {
    "style": "gradient"
  },
  "navbar": {
    "links": [
      {
        "label": "Schedule Demo",
        "href": "https://calendar.google.com/calendar/appointments/schedules/AcZssZ0xP6nxXZ5RWb6zQrYcADLF1-g6p-fyyMm5rdE6z6SHqNQPBPEJzoVdY--CLtVXGHy8H80RTyHV?gv=true"
      },
      {
        "label": "Support",
        "href": "mailto:sneh@miraiminds.co"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {}
  }
}
